rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.leaguePoints == 0
        && request.resource.data.quizzesTaken == 0
        && request.resource.data.averageAccuracy == 0
        && request.resource.data.status == 'active';
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student';
      allow update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'live');
      allow create, update, delete: if isAdmin();
      match /questions/{questionId} {
        // Question documents must contain only public question data. The answer key is stored separately.
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.status == 'live');
        allow create, update, delete: if isAdmin();
      }
    }

    match /attempts/{attemptId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.quizId is string
        && request.resource.data.answers is map
        && request.resource.data.startedAt is string
        && request.resource.data.keys().hasOnly(['studentId','quizId','status','answers','startedAt','createdAt']);
      // Students never update attempts directly. Trusted Cloud Functions finalize them.
      allow update, delete: if isAdmin();
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn() && resource.data.active == true;
      allow write: if isAdmin();
    }

    match /admin_users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /quizAnswerKeys/{quizId} {
      allow read, write: if isAdmin();
    }
  }
}
