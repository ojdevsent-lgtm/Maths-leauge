rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /quiz_configs/{quizId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if isAdmin();
    }

    match /quiz_questions/{questionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if (signedIn() && resource.data.student_id == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if (signedIn() && resource.data.active == true) || isAdmin();
      allow write: if isAdmin();
    }

    match /admin_users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /meta/{documentId} {
      allow read, write: if false;
    }
  }
}
