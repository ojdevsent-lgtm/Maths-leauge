rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.leaguePoints == 0
        && request.resource.data.quizzesTaken == 0
        && request.resource.data.averageAccuracy == 0
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || (isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.leaguePoints is number
        && request.resource.data.quizzesTaken is number
        && request.resource.data.averageAccuracy is number
        && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student';
      allow update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'live');
      allow create, update, delete: if isAdmin();
      match /questions/{questionId} {
        allow read: if isAdmin() || (signedIn()
          && get(/databases/$(database)/documents/quizzes/$(quizId)).data.status == 'live');
        allow create, update, delete: if isAdmin();
      }
    }

    // One immutable attempt is allowed per student for each quiz.
    // The deterministic document ID is {studentUid}_{quizId}.
    match /attempts/{attemptId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);

      allow create: if signedIn()
        && attemptId == request.auth.uid + '_' + request.resource.data.quizId
        && !exists(/databases/$(database)/documents/attempts/$(attemptId))
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.quizId is string
        && request.resource.data.answers is map
        && request.resource.data.status == 'submitted'
        && request.resource.data.score is number
        && request.resource.data.accuracy is number
        && request.resource.data.leaguePointsAwarded is number
        && request.resource.data.keys().hasOnly([
          'studentId',
          'quizId',
          'answers',
          'score',
          'accuracy',
          'leaguePointsAwarded',
          'status',
          'submittedAt'
        ]);

      // Submitted attempts are immutable for students.
      // Admins can correct/manage attempts when necessary.
      allow update, delete: if isAdmin();
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (isSelf(uid)
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.leaguePoints is number
        && request.resource.data.quizzesTaken is number
        && request.resource.data.averageAccuracy is number);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn() && resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /admin_users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /quizAnswerKeys/{quizId} {
      allow read, write: if isAdmin();
    }
  }
}
