rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.full_name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.school is string
        && request.resource.data.state is string
        && request.resource.data.points == 0
        && request.resource.data.quizzes_taken == 0
        && request.resource.data.status == "active";
      // Student-owned profile fields are intentionally immutable from the client after signup.
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /quiz_configs/{quizId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if isAdmin();
    }

    match /quiz_questions/{questionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if (signedIn() && resource.data.student_id == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if (signedIn() && resource.data.active == true) || isAdmin();
      allow write: if isAdmin();
    }

    match /admin_users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /meta/{documentId} {
      allow read, write: if false;
    }
  }
}
